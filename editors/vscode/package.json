{
  "name": "neolint-vscode",
  "displayName": "NeoLint",
  "description": "LSL diagnostics from the NeoLint analysis engine.",
  "version": "0.2.0",
  "publisher": "mindwork64",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindwork64/neolint.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc -p ./ --noEmit",
    "package": "npm run compile && vsce package"
  },
  "contributes": {
    "configuration": {
      "title": "NeoLint",
      "properties": {
        "neolint.serverPath": {
          "type": "string",
          "default": "neolint-lsp",
          "description": "Path or command used to start the NeoLint language server."
        },
        "neolint.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional command-line arguments passed to neolint-lsp."
        },
        "neolint.configPath": {
          "type": "string",
          "default": "",
          "description": "Optional config overlay applied to every script. Relative paths are resolved from that script's selected workspace folder (files outside every folder need an absolute path). If empty, NeoLint discovers neolint.project or .neolint.conf per workspace."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "18.19.39",
    "@types/vscode": "1.85.0",
    "typescript": "5.4.5",
    "@vscode/vsce": "4.1.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
