---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070810" />
    <meta name="robots" content="noindex" />
    <title>Page not found — neolint</title>
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader />
      <main class="not-found">
        <div class="eyebrow"><span></span> ROUTE NOT FOUND</div>
        <div class="not-found-code">404</div>
        <h1>This page went <em>off the grid.</em></h1>
        <p>The address may be outdated, or the page may have moved. The project itself is still right where you left it.</p>
        <a class="button button-primary" href={base}>Return to neolint <span aria-hidden="true">→</span></a>
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    width: min(760px, calc(100% - 48px));
    min-height: 510px;
    align-content: center;
    margin: 0 auto;
    padding: 70px 0;
  }
  .not-found-code {
    margin: 27px 0 4px;
    background: linear-gradient(100deg, #45dfff, #6682ff 55%, #c15bff);
    background-clip: text;
    color: transparent;
    font-size: clamp(6.5rem, 19vw, 12rem);
    font-weight: 850;
    letter-spacing: -.1em;
    line-height: .9;
  }
  .not-found h1 {
    margin: 22px 0 12px;
    color: #f0f4ff;
    font-size: clamp(2.4rem, 6vw, 4.3rem);
    letter-spacing: -.065em;
    line-height: 1;
  }
  .not-found h1 em {
    background: linear-gradient(100deg, #45dfff, #6682ff 55%, #c15bff);
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-style: normal;
  }
  .not-found p {
    max-width: 510px;
    margin: 0 0 27px;
    color: #a4b2ca;
    font-size: .98rem;
    line-height: 1.75;
  }
  @media (max-width: 700px) {
    .not-found { width: calc(100% - 32px); min-height: 420px; }
  }
</style>
